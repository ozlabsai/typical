diff --git a/tests/test_vllm_provider.py b/tests/test_vllm_provider.py
new file mode 100644
index 0000000..7dfba24
--- /dev/null
+++ b/tests/test_vllm_provider.py
@@ -0,0 +1,29 @@
+import os
+import unittest
+from unittest.mock import patch
+
+from core.providers import configuration, resolve_model
+
+
+class VllmProviderTests(unittest.TestCase):
+    def test_custom_endpoint_cannot_be_recorded_as_jev(self):
+        with self.assertRaisesRegex(ValueError, "not Jev"):
+            configuration("typesafe:jev-1.13.0", base_url="http://127.0.0.1:8010")
+
+    def test_vllm_identity_and_thinking_switch(self):
+        with patch.dict(os.environ, {"VLLM_BASE_URL": "http://127.0.0.1:8000/v1"}, clear=True):
+            config = configuration("vllm:google/gemma-4-12B-it", thinking="medium")
+            self.assertEqual(config.identity.name, "vllm:google/gemma-4-12B-it")
+            self.assertEqual(config.identity.effort, "medium")
+            self.assertEqual(config.question_mode, "one")
+            model = resolve_model(config)
+        self.assertEqual(model.settings["extra_body"],
+                         {"chat_template_kwargs": {"enable_thinking": True, "reasoning_effort": "medium"}})
+        off = resolve_model(configuration("vllm:x", thinking="off", base_url="http://h/v1"))
+        self.assertEqual(off.settings["extra_body"], {"chat_template_kwargs": {"enable_thinking": False}})
+        with self.assertRaisesRegex(ValueError, "VLLM_BASE_URL"):
+            configuration("vllm:x")
+
+
+if __name__ == "__main__":
+    unittest.main()
