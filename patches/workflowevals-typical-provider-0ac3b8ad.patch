index 0000000000000000000000000000000000000000..1fe2f74af8531853d3006b233f284166b761a700
--- /dev/null
+++ b/tests/test_typical_provider.py
@@ -0,0 +1,148 @@
+from __future__ import annotations
+
+import json
+import os
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import ANY, patch
+
+from typesafe_sdk import TypeSafeError
+
+from core.clients import QuestionClient
+from core.providers import ModelConfig, configuration, resolve_model
+
+MODEL = "typical-r050-sha256-0123456789abcdef"
+BASE_URL = "http://127.0.0.1:8090"
+
+
+class TypicalConfigurationTests(unittest.TestCase):
+    def test_defaults_and_identity_preserve_literal_model(self):
+        with patch.dict(os.environ, {"TYPICAL_BASE_URL": BASE_URL}, clear=True):
+            config = configuration(f"typical:{MODEL}")
+
+        self.assertEqual(config.provider, "typical")
+        self.assertEqual(config.model, MODEL)
+        self.assertEqual(config.thinking, "off")
+        self.assertEqual(config.question_mode, "all")
+        self.assertEqual(config.base_url, BASE_URL)
+        self.assertEqual(config.identity.name, f"typical:{MODEL}")
+        self.assertEqual(config.identity.lab, "other")
+        self.assertIsNone(config.identity.effort)
+
+    def test_typical_requires_its_own_explicit_base_url(self):
+        typesafe_only = {
+            "TYPESAFE_API_KEY": "jev-secret",
+            "TYPESAFE_BASE_URL": "https://api.typesafe.ai",
+        }
+        with patch.dict(os.environ, typesafe_only, clear=True), self.assertRaisesRegex(
+            ValueError, "TYPICAL_BASE_URL|--base-url"
+        ):
+            configuration(f"typical:{MODEL}")
+        with self.assertRaisesRegex(ValueError, "TYPICAL_BASE_URL|--base-url"):
+            ModelConfig(model=MODEL, provider="typical", base_url="   ")
+
+    def test_typesafe_remains_restricted_to_jev(self):
+        with patch.dict(os.environ, {"TYPESAFE_BASE_URL": "https://api.typesafe.ai"}, clear=True):
+            with self.assertRaisesRegex(ValueError, "only jev-1.13.0"):
+                configuration("typesafe:not-jev")
+            jev = configuration("typesafe:jev-1.13.0")
+
+        self.assertEqual(jev.provider, "typesafe")
+        self.assertEqual(jev.model, "jev-1.13.0")
+
+    def test_serialization_discloses_endpoint_but_never_credentials(self):
+        env = {"TYPICAL_BASE_URL": BASE_URL, "TYPICAL_API_KEY": "typical-secret"}
+        with patch.dict(os.environ, env, clear=True):
+            config = configuration(f"typical:{MODEL}")
+
+        wire = json.loads(config.model_dump_json())
+        self.assertEqual(wire["provider"], "typical")
+        self.assertEqual(wire["model"], MODEL)
+        self.assertEqual(wire["base_url"], BASE_URL)
+        self.assertNotIn("api_key", wire)
+        self.assertEqual(ModelConfig.model_validate(wire), config)
+
+
+class TypicalClientTests(unittest.TestCase):
+    def test_missing_typical_key_never_falls_back_to_typesafe_key(self):
+        env = {
+            "TYPICAL_BASE_URL": BASE_URL,
+            "TYPESAFE_API_KEY": "must-not-leak",
+        }
+        with patch.dict(os.environ, env, clear=True):
+            config = configuration(f"typical:{MODEL}")
+            with patch("core.clients.TypeSafeClient") as sdk:
+                with self.assertRaisesRegex(ValueError, "TYPICAL_API_KEY"):
+                    QuestionClient(config)
+                sdk.assert_not_called()
+
+    def test_native_client_receives_only_typical_credentials_and_literal_model(self):
+        env = {
+            "TYPICAL_API_KEY": "typical-secret",
+            "TYPESAFE_API_KEY": "must-not-leak",
+            "TYPESAFE_DEFAULT_MODEL": "must-not-replace-literal",
+        }
+        with patch.dict(os.environ, env, clear=True):
+            config = configuration(f"typical:{MODEL}", base_url=BASE_URL)
+            with patch("core.clients.TypeSafeClient") as sdk, patch(
+                "core.clients.SystemOneAdapterClient"
+            ) as adapter:
+                sdk.return_value.system_one.return_value = SimpleNamespace(model=MODEL)
+                client = QuestionClient(config)
+                result = client.system_one(
+                    model=resolve_model(config),
+                    state={"ticket": "example"},
+                    questions={},
+                )
+
+        sdk.assert_called_once_with(
+            api_key="typical-secret",
+            model=MODEL,
+            base_url=BASE_URL,
+            timeout=config.timeout_s,
+            retry=ANY,
+        )
+        self.assertEqual(sdk.call_args.kwargs["retry"].max_retries, 0)
+        adapter.assert_not_called()
+        sdk.return_value.system_one.assert_called_once_with(
+            state={"ticket": "example"},
+            questions={},
+            model=MODEL,
+        )
+        self.assertIs(result, sdk.return_value.system_one.return_value)
+
+    def test_typesafe_keeps_existing_retry_policy(self):
+        env = {
+            "TYPESAFE_API_KEY": "jev-secret",
+            "TYPESAFE_BASE_URL": "https://api.typesafe.ai",
+        }
+        with patch.dict(os.environ, env, clear=True):
+            config = configuration("typesafe:jev-1.13.0")
+            with patch("core.clients.TypeSafeClient") as sdk:
+                QuestionClient(config)
+
+        sdk.assert_called_once_with(
+            base_url="https://api.typesafe.ai",
+            timeout=config.timeout_s,
+            retry=ANY,
+        )
+        self.assertEqual(sdk.call_args.kwargs["retry"].max_retries, 5)
+
+    def test_response_model_must_exactly_match_request_model(self):
+        env = {"TYPICAL_API_KEY": "typical-secret"}
+        with patch.dict(os.environ, env, clear=True):
+            config = configuration(f"typical:{MODEL}", base_url=BASE_URL)
+            with patch("core.clients.TypeSafeClient") as sdk:
+                sdk.return_value.system_one.return_value = SimpleNamespace(model="mutable-alias")
+                client = QuestionClient(config)
+                with self.assertRaisesRegex(TypeSafeError, "response model mismatch"):
+                    client.system_one(model=resolve_model(config), state="example", questions={})
+
+    def test_pricing_does_not_claim_unverified_typical_rates(self):
+        prices = json.loads((Path(__file__).parents[1] / "core" / "pricing.json").read_text())
+        self.assertFalse(any(key.startswith("typical:") for key in prices))
+
+
+if __name__ == "__main__":
+    unittest.main()
