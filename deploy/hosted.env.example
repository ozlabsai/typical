# Copy to deploy/hosted.env (git-ignored) and fill in. deploy/runpod.sh copies it to the pod (0600); it is never printed.
# Session signing key. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TYPICALLY_SECRET=
# Invite codes, comma-separated. Long and random: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
TYPICALLY_INVITES=
# Admin codes (also valid invites): see every model, no daily run limit.
TYPICALLY_ADMINS=
# Quotas (defaults shown)
TYPICALLY_DAILY_RUNS=3
TYPICALLY_MAX_JOBS=2
# Training pods (H100s, rented per run by scripts/typically_job.py) and the training data on Hugging Face
RUNPOD_API_KEY=
HF_TOKEN=
# Optional: "Read by Claude" plans and question parsing (else the built-in rules)
OPENROUTER_API_KEY=
# Optional: a stable public URL for share links (a named tunnel / your domain); the quick tunnel's URL is used otherwise
TYPICALLY_PUBLIC_URL=
